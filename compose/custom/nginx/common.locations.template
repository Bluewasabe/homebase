  index index.html;
  add_header Cache-Control "no-store" always;

  location /shared/ { alias /usr/share/nginx/html/shared/; }

  # healthwatch snapshot (feed container on hub)
  location /feed/ {
    proxy_pass http://${HUB_IP}:3009/;
    proxy_set_header Host $host;
  }
  # Uptime Kuma status-page JSON (same origin, so no CORS needed)
  location /kuma/ {
    proxy_pass http://${HUB_IP}:3001/;
    proxy_set_header Host $host;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
  # Proxmox API, read-only token injected server-side
  location /pve/ {
    proxy_pass ${PROXMOX_URL}/;
    proxy_ssl_verify off;
    proxy_set_header Authorization "PVEAPIToken=${PROXMOX_TOKEN_ID}=${PROXMOX_TOKEN_SECRET}";
  }
  # Plex, token injected server-side, JSON forced
  location /plex/ {
    proxy_pass ${PLEX_URL}/;
    proxy_set_header Accept "application/json";
    proxy_set_header X-Plex-Token "${PLEX_TOKEN}";
  }
  # Minecraft / Bedrock status sidecar
  location /mc/ {
    proxy_pass http://mcstatus:8000/;
    proxy_read_timeout 15s;
  }
